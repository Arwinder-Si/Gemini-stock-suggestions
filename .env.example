# Dhan API credentials
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Comma-separated "NAME:SECURITY_ID" pairs, e.g. RELIANCE:11536,TCS:3456
SYMBOL_SECURITY_IDS=

# Webex bot (outbound alerts + ChatOps listener)
WEBEX_TOKEN=
WEBEX_ROOM_ID=

# Required for interactive ChatOps commands (/ping, /pnl, /plan, /paper, /journal, /stats, /kill).
# Must be a public, internet-reachable URL pointing at webex_listener.py.
# Use HTTPS when possible (ngrok works for testing: ngrok http 5050).
BOT_PUBLIC_URL=
BOT_PORT=5050

# MongoDB Atlas Analytics Database (optional for local testing, recommended for production)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# Paper Trading & Agent Risk Controls
TRADING_MODE=paper
PAPER_STARTING_CAPITAL=1000000
MAX_DAILY_TRADES=5
MAX_DAILY_LOSS_RUPEES=10000
RISK_PER_TRADE_PCT=0.01
MAX_SECTOR_EXPOSURE_PCT=0.30
