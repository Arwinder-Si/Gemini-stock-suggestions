# Hermes — environment configuration
# Copy to .env and fill in values:  cp .env.example .env

# ── MongoDB Atlas (required for paper-trade persistence) ─────────────────────
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Database Access → Add user (readWrite on hermes_analytics)
# 3. Network Access → Add IP (0.0.0.0/0 for VM, or your home IP)
# 4. Connect → Drivers → copy connection string, replace <password>
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Last resort on corporate VMs with SSL inspection (dev/debug only):
# MONGODB_TLS_INSECURE=true

# ── Webex ChatOps (outbound polling — no public URL required) ────────────────
WEBEX_TOKEN=
WEBEX_ROOM_ID=
BOT_POLL_INTERVAL_SEC=5
# Optional — defaults to var/state/webex_poll_state.json
# BOT_STATE_FILE=var/state/webex_poll_state.json

# ── Dhan market data (optional — only needed for live Dhan WebSocket feed) ───
# Paper mode uses yfinance by default when these are empty.
# Set FEED_SOURCE=dhan to force Dhan even in paper mode.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# ── Agent / paper trading ─────────────────────────────────────────────────────
TRADING_MODE=paper
FEED_SOURCE=auto
PAPER_STARTING_CAPITAL=1000000
MAX_DAILY_TRADES=5
MAX_DAILY_LOSS_RUPEES=10000
RISK_PER_TRADE_PCT=0.01
MAX_SECTOR_EXPOSURE_PCT=0.30

# ── Strategy ──────────────────────────────────────────────────────────────────
ORB_START_TIME=09:15
ORB_END_TIME=09:30
MIN_VOLUME_THRESHOLD=10000
RISK_REWARD_RATIO=1.5
TIME_BASED_EXIT=15:15
SCREENER_TOP_N=5

# ── Fallback symbol list (used only if no trade plan file exists) ─────────────
# SYMBOL_SECURITY_IDS=RELIANCE:11536,TCS:3456
